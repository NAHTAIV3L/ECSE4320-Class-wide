; QD=1 random 4 KiB read baseline.  Override --filename/--size/--runtime
; from the command line (see scripts/run_experiments.sh).
[global]
ioengine=libaio
direct=1
time_based=1
runtime=30
ramp_time=5
size=1G
filename=/tmp/ecse4320-fio-test.dat
group_reporting=1
randrepeat=1
norandommap=1
invalidate=1
percentile_list=50:95:99:99.9

[random_read_4k]
rw=randread
bs=4k
iodepth=1
numjobs=1
